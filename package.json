{
  "name": "watch-movie",
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "ui"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev --port 4321",
    "build": "bun scripts/build-site.ts",
    "lint": "oxlint --type-aware --type-check",
    "test": "bun test",
    "check:backend": "bun run --filter @watch/backend check",
    "check:ui": "bun run --filter @watch/ui check",
    "e2e": "playwright test --project=ci",
    "e2e:live": "playwright test --project=live --project=live-mobile --retries=2",
    "check": "bun run lint && bun test && bun run check:backend && bun run check:ui && bun run build",
    "deploy": "bun run build && bun alchemy deploy --stage prod",
    "prepare": "husky"
  },
  "dependencies": {
    "goeist": "^0.1.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/oxlint-config": "^0.1.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "alchemy": "2.0.0-beta.87",
    "bun-types": "^1.4.5",
    "effect": "4.1.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "^7.1.0-beta.tsrs3",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
