{
  "name": "watch-movie",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "sync": "astro sync",
    "lint": "oxlint --type-aware --type-check",
    "test": "bun test",
    "e2e": "playwright test --project=ci",
    "e2e:live": "playwright test --project=live --project=live-mobile --retries=2",
    "check": "bun run sync && bun run lint && bun test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@tailwindcss/vite": "4.3.5",
    "astro": "^7.4.13",
    "goeist": "^0.1.0",
    "react": "19",
    "react-dom": "19",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.1.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "^7.1.0-beta.tsrs3",
    "typescript": "^7.0.2",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
