{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types", "astro/client"],
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts",
    "e2e",
    "ui",
    "astro.config.ts",
    "playwright.config.ts",
    "alchemy.run.ts"
  ]
}
