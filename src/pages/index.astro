---
import { SITE_URL } from "../consts";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";

export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>watch — find a stream link</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='5 3 19 12 5 21 5 3'/></svg>">
<link rel="canonical" href={SITE_URL + "/"}>
<meta name="description" content="Paste an IMDb or TMDB ID and get a working stream link. No sign-up, no app, just a click to play.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="watch">
<meta property="og:title" content="watch — find a stream link">
<meta property="og:description" content="Paste an IMDb or TMDB ID and get a working stream link.">
<meta property="og:url" content={SITE_URL + "/"}>
<meta property="og:image" content={SITE_URL + "/og.png"}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="watch — paste an IMDb or TMDB ID to get a stream link.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="watch — find a stream link">
<meta name="twitter:description" content="Paste an IMDb or TMDB ID and get a working stream link.">
<style>
  :root {
    --ink: #0A0A0A;
    --paper: #FAFAFA;
    --surface: #FFFFFF;
    --gray: #6B6B6B;
    --line: #E4E4E4;
  }

  :global(*) { margin: 0; padding: 0; box-sizing: border-box; }

  .visually-hidden:where(:not(:focus-within, :active)) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }

  :focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  ::selection { background: var(--ink); color: var(--paper); }
  input { caret-color: var(--ink); font-variant-numeric: tabular-nums; }
  button, a { touch-action: manipulation; }
  button { user-select: none; -webkit-user-select: none; }
  html { -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; overscroll-behavior: none; scrollbar-color: #C9C9C9 var(--paper); scrollbar-width: thin; }

  body {
    min-height: 100vh;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Archivo', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    padding-top: max(48px, env(safe-area-inset-top, 0px));
    padding-bottom: max(48px, env(safe-area-inset-bottom, 0px));
  }

  .page { width: 100%; max-width: 720px; display: flex; flex-direction: column; align-items: center; }
  .col { width: 100%; }

  .brand { text-align: center; font-size: 13px; font-weight: 700; letter-spacing: 0.36em; text-transform: uppercase; }
  .brand span { display: block; margin-top: 9px; font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gray); }

  .search { display: flex; gap: 8px; margin-top: 46px; }
  .search input {
    flex: 1 1 auto;
    min-width: 0;
    height: 58px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    outline: none;
  }
  .search input::placeholder { color: var(--gray); }
  .search input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(10, 10, 10, 0.08); }
  .search input.error { border-color: var(--ink); border-width: 2px; }

  .btn-primary {
    height: 58px;
    padding: 0 26px;
    border: 1px solid var(--ink);
    border-radius: 4px;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
  }
  .btn-primary:hover { background: #2B2B2B; }
  .btn-primary:active { transform: scale(0.99); }
  .btn-primary:disabled { background: var(--gray); border-color: var(--gray); cursor: wait; }

  .spinner {
    width: 14px; height: 14px;
    border: 2px solid rgba(250, 250, 250, 0.45);
    border-top-color: var(--paper);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  #go.loading .spinner { opacity: 1; animation: spin 0.7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .status, .hint { margin-top: 10px; font-size: 11px; line-height: 1.5; color: var(--gray); text-align: center; }
  .status:empty { margin-top: 0; }
  .status.loading { color: var(--gray); }
  .status.error { color: var(--ink); font-weight: 600; }
  .hint a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  dialog.modal {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--ink);
    max-width: min(720px, calc(100% - 32px));
    width: 100%;
    margin: auto;
    overflow: visible;
  }
  dialog.modal::backdrop { background: rgba(10, 10, 10, 0.18); }
  dialog.modal[open] { display: block; }

  .record {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 34px 36px 26px;
    box-shadow: 0 12px 30px rgba(10, 10, 10, 0.06);
  }
  .title { font-size: 34px; font-weight: 600; line-height: 1.12; letter-spacing: -0.035em; text-wrap: balance; }
  .meta { margin-top: 8px; font-size: 12px; font-weight: 500; letter-spacing: 0.04em; color: var(--gray); }
  .description { margin-top: 12px; font-size: 13px; line-height: 1.65; color: var(--gray); }
  .type { margin-top: 14px; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray); }

  .rows { margin-top: 26px; border-top: 1px solid var(--line); }
  .row {
    display: flex;
    gap: 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .row .k { width: 110px; flex: none; padding-top: 2px; font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gray); }
  .row .v { flex: 1; min-width: 0; font-variant-numeric: tabular-nums; word-break: break-all; }
  .row .v a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  .warning { margin-top: 18px; font-size: 11.5px; line-height: 1.65; color: var(--gray); }
  .warning strong { color: var(--ink); font-weight: 600; }

  .actions { margin-top: 26px; display: flex; justify-content: flex-end; gap: 8px; }
  .btn-ghost, .btn-icon {
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .btn-ghost { padding: 0 20px; }
  .btn-ghost:hover, .btn-icon:hover { border-color: var(--ink); }
  .btn-icon { width: 44px; padding: 0; display: grid; place-items: center; }
  .btn-icon.loading svg { animation: spin 0.7s linear infinite; }
  .btn-icon.copied { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn-primary.small { height: 44px; font-size: 11px; padding: 0 24px; }

  .notice { margin-top: 56px; width: 100%; border-top: 1px solid var(--line); padding-top: 16px; text-align: center; }
  .notice p { max-width: 620px; margin: 0 auto; font-size: 11px; line-height: 1.8; color: var(--gray); }

  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (max-width: 640px) {
    body { align-items: flex-start; padding-top: 64px; padding-bottom: 40px; }
    .search { flex-direction: column; gap: 8px; margin-top: 34px; }
    .btn-primary { width: 100%; }
    .record { padding: 26px 20px 22px; }
    .title { font-size: 27px; }
    .row { flex-direction: column; gap: 5px; }
    .row .k { width: auto; }
    .actions { flex-wrap: wrap; }
    .btn-ghost, .btn-primary.small { flex: 1 1 auto; }
    .btn-icon { flex: 0 0 44px; }
    .notice { margin-top: 40px; }
  }
</style>
</head>
<body>
  <main class="page">
    <div class="col">
      <div class="brand">watch<span>Look up. Play.</span></div>

      <form class="search" id="form">
        <label class="visually-hidden" for="imdb">IMDb or TMDB ID or link</label>
        <input type="text" id="imdb" name="id" placeholder="IMDb or TMDB ID or link" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="go" aria-invalid="false">
        <button type="submit" id="go" class="btn-primary">
          <span class="spinner"></span>
          <span class="btn-text">Watch now</span>
        </button>
      </form>

      <p class="status" id="status" role="status" aria-live="polite"></p>
      <p class="hint">IMDb ID or TMDB ID? Either works. Example: <a href="#id=tt1300854">tt1300854</a>.</p>
    </div>

    <dialog class="modal" id="modal" aria-labelledby="modal-title">
      <div class="record">
        <h2 class="title" id="modal-title">Stream Found</h2>
        <p class="meta" id="modal-meta"></p>
        <p class="description" id="modal-description" style="display: none;"></p>
        <div class="type" id="modal-type"></div>

        <div class="rows">
          <div class="row"><span class="k">IMDb</span><span class="v"><a id="modal-imdb" href="#" target="_blank" rel="noopener"></a></span></div>
          <div class="row"><span class="k">Provider</span><span class="v" id="modal-provider"></span></div>
          <div class="row"><span class="k">Stream URL</span><span class="v"><a id="modal-url-text" href="#" target="_blank" rel="noopener"></a></span></div>
        </div>

        <p class="warning">You'll leave this site and play on <strong id="modal-warning-provider"></strong>. We don't control external sites.</p>

        <div class="actions">
          <button class="btn-ghost" id="modal-cancel">Cancel</button>
          <button class="btn-icon" id="modal-try-another" title="Get another stream link" aria-label="Get another stream link">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12a9 9 0 1 1-3-6.7L21 8"/>
              <path d="M21 3v5h-5"/>
            </svg>
          </button>
          <button class="btn-icon" id="modal-copy" title="Copy link" aria-label="Copy link">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
          </button>
          <button class="btn-primary small" id="modal-watch">Watch</button>
        </div>
      </div>
    </dialog>

    <div class="notice">
      <p>We don't host anything. We only link to third-party providers. Check the URL before playing. Prefer an ad blocker for safety.</p>
    </div>
  </main>

<script src="../scripts/watch.ts"></script>
</body>
</html>
