---
import { SITE_URL } from "../consts";
import WatchApp from "../components/WatchApp";
import "../styles/global.css";

export const prerender = true;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>watch — find a stream link</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='5 3 19 12 5 21 5 3'/></svg>">
<link rel="canonical" href={SITE_URL + "/"}>
<meta name="description" content="Paste an IMDb or TMDB ID and get a working stream link. No sign-up, no app, just a click to play.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="watch">
<meta property="og:title" content="watch — find a stream link">
<meta property="og:description" content="Paste an IMDb or TMDB ID and get a working stream link.">
<meta property="og:url" content={SITE_URL + "/"}>
<meta property="og:image" content={SITE_URL + "/og.png"}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="watch — paste an IMDb or TMDB ID to get a stream link.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="watch — find a stream link">
<meta name="twitter:description" content="Paste an IMDb or TMDB ID and get a working stream link.">
</head>
<body class="flex min-h-dvh items-center justify-center bg-background p-5 py-12 text-foreground antialiased max-sm:items-start max-sm:pt-16">
  <main class="flex w-full max-w-3xl flex-col items-center">
    <h1 class="text-center text-xs font-bold tracking-[0.36em] uppercase">
      watch
      <span aria-hidden="true" class="mt-2 block text-[10px] font-medium tracking-[0.22em] text-muted">
        Look up. Play.
      </span>
    </h1>

    <div class="w-full">
      <WatchApp client:load />
    </div>

    <footer class="mt-14 w-full border-t border-separator pt-4 text-center">
      <p class="mx-auto max-w-xl text-xs leading-relaxed text-muted">
        We don't host anything. We only link to third-party providers. Check the URL before playing.
        Prefer an ad blocker for safety.
      </p>
    </footer>
  </main>
</body>
</html>
