---
import { SITE_URL } from "../consts";
import { ClientRouter } from "astro:transitions";
import "@fontsource/geist-pixel";

export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0A0A0A">
<meta name="color-scheme" content="dark">
<title>Watch movies and TV shows online. Paste an IMDb or TMDB ID.</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='5 3 19 12 5 21 5 3'/></svg>">
<link rel="canonical" href={SITE_URL + "/"}>
<meta name="description" content="Paste an IMDb or TMDB ID or link to find a working stream for any movie or TV show. No sign-up, no app, just a click to play.">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Watch">
<meta property="og:title" content="Watch movies and TV shows online. Paste an IMDb or TMDB ID.">
<meta property="og:description" content="Paste an IMDb or TMDB ID or link to find a working stream for any movie or TV show.">
<meta property="og:url" content={SITE_URL + "/"}>
<meta property="og:image" content={SITE_URL + "/og.png"}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Watch movies and TV shows online. Paste an IMDb or TMDB ID or link.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Watch movies and TV shows online. Paste an IMDb or TMDB ID.">
<meta name="twitter:description" content="Paste an IMDb or TMDB ID or link to find a working stream for any movie or TV show.">
<ClientRouter />
<style>
  :root {
    --canvas: #0A0A0A;
    --ink: #FFFFFF;
    --ink-secondary: rgb(255 255 255 / 72%);
    --ink-tertiary: rgb(255 255 255 / 60%);
    --border: rgb(255 255 255 / 10%);
    --border-strong: rgb(255 255 255 / 18%);
    --fill-hover: rgb(255 255 255 / 9%);
    --fill-pressed: rgb(255 255 255 / 14%);
    --success: #22c55e;
    --overlay: rgb(0 0 0 / 64%);
  }

  /* Global reset: Astro would scope `*` to [data-cid], outranking the
     unscoped body rule below. :global keeps the original zero weight. */
  :global(*) { margin: 0; padding: 0; box-sizing: border-box; }

  .visually-hidden:where(:not(:focus-within, :active)) {
    position: absolute !important;
    clip-path: inset(50%) !important;
    overflow: hidden !important;
    width: 1px !important;
    height: 1px !important;
    margin: -1px !important;
    padding: 0 !important;
    border: 0 !important;
    white-space: nowrap !important;
  }

  :focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  html, body { height: 100%; }

  html {
    -webkit-tap-highlight-color: transparent;
    -webkit-text-size-adjust: 100%;
    overscroll-behavior: none;
  }

  button, a {
    touch-action: manipulation;
  }

  button {
    user-select: none;
    -webkit-user-select: none;
  }

  body {
    font-family: 'Geist Pixel', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    background: var(--canvas);
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    padding-top: max(24px, env(safe-area-inset-top, 0px));
    padding-right: max(24px, env(safe-area-inset-right, 0px));
    padding-bottom: max(24px, env(safe-area-inset-bottom, 0px));
    padding-left: max(24px, env(safe-area-inset-left, 0px));
  }

  .container {
    width: 100%;
    max-width: 480px;
  }

  .header {
    margin-bottom: 48px;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .subtitle {
    color: var(--ink-secondary);
    margin-top: 8px;
  }

  .form-group {
    display: flex;
    align-items: stretch;
  }

  input {
    flex: 1;
    padding: 16px 20px;
    font-size: 1rem;
    font-family: inherit;
    font-weight: 400;
    border: 1px solid var(--border-strong);
    border-radius: 8px 0 0 8px;
    background: var(--canvas);
    color: var(--ink);
    outline: none;
    min-width: 0;
    transition: border-color 0.15s ease;
  }

  input::placeholder {
    color: var(--ink-tertiary);
  }

  input:focus {
    border-color: var(--ink);
  }

  input.error {
    border-color: var(--ink);
  }

  input.loading {
    border-color: var(--ink);
    animation: pulse 0.8s infinite alternate;
  }

  @keyframes pulse {
    to { border-color: var(--border-strong); }
  }

  button {
    padding: 16px 24px;
    font-size: 1rem;
    font-family: inherit;
    font-weight: 500;
    border: 1px solid var(--ink);
    border-radius: 0 8px 8px 0;
    background: var(--ink);
    color: var(--canvas);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 120px;
  }

  button:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    button:hover {
      background: var(--ink-secondary);
      border-color: var(--ink-secondary);
    }
  }

  button:disabled {
    background: var(--ink-tertiary);
    border-color: var(--ink-tertiary);
    cursor: wait;
  }

  .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--canvas);
    border-top-color: transparent;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  button.loading .spinner {
    opacity: 1;
    animation: spin 0.7s linear infinite;
  }

  button.loading .btn-text {
    opacity: 0.7;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .status {
    margin-top: 16px;
    font-size: 0.875rem;
    min-height: 1.5rem;
    transition: opacity 0.2s ease;
  }

  .status.loading {
    color: var(--ink-tertiary);
  }

  .status.error {
    color: var(--ink-secondary);
  }

  .help {
    margin-top: 8px;
    color: var(--ink-tertiary);
    font-size: 0.875rem;
  }

  /* Recent links are built by script, so they carry no scope attribute. */
  :global(.help a) {
    color: var(--ink-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.help a:hover) {
      color: var(--ink);
    }
  }

  .disclaimer {
    margin-top: 16px;
    color: var(--ink-tertiary);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .container {
      max-width: 100%;
    }

    .header {
      margin-bottom: 32px;
    }

    .disclaimer {
      margin-top: 24px;
      font-size: 0.75rem;
    }

    .form-group {
      flex-direction: column;
      gap: 0;
    }

    input {
      border-radius: 8px 8px 0 0;
      border-right: 1px solid var(--border-strong);
      border-bottom: none;
    }

    .form-group button {
      border-radius: 0 0 8px 8px;
      border-top: none;
    }

    .modal {
      padding: 20px;
    }

    .modal .detail {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      padding: 10px 0;
    }

    .modal .detail-label {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    .modal .detail-value {
      flex: 1 1 auto;
      min-width: 0;
      max-width: none;
      text-align: right;
      justify-content: flex-end;
      overflow-wrap: anywhere;
      font-size: 0.8rem;
    }

    .modal .actions {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 8px;
    }

    .modal .btn-secondary,
    .modal .btn-primary {
      width: auto;
      min-width: 0;
      min-height: 44px;
      flex: 1 1 auto;
      padding: 12px 8px;
      font-size: 0.8rem;
    }

    .modal .btn-secondary.icon {
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      padding: 0;
    }
  }

  dialog.modal {
    inset: 0;
    margin: auto;
    overscroll-behavior: contain;
  }

  dialog.modal::backdrop {
    background: var(--overlay);
    overflow: hidden;
    overscroll-behavior: contain;
  }

  .modal {
    background: var(--canvas);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    padding: 32px;
    width: 100%;
    max-width: min(400px, calc(100% - 32px));
  }

  .modal h2 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .modal .meta {
    color: var(--ink-secondary);
    font-size: 0.875rem;
    margin-bottom: 24px;
  }

  .modal-description {
    color: var(--ink-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 16px 0 8px;
  }

  .modal .detail {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }

  .modal .detail:first-of-type {
    border-top: none;
  }

  .modal .detail-label {
    color: var(--ink-tertiary);
    font-size: 0.875rem;
  }

  .modal .detail-value {
    font-size: 0.875rem;
    text-align: right;
    word-break: break-all;
    max-width: 60%;
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
  }

  .modal .warning {
    margin-top: 16px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--ink-secondary);
  }

  .modal .warning strong {
    color: var(--ink);
  }

  .modal .detail-value a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .modal .detail-value a:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .modal .btn-secondary.icon.copied {
    color: var(--success);
    border-color: var(--success);
  }


  .modal .actions {
    display: flex;
    gap: 8px;
    margin-top: 24px;
    flex-wrap: nowrap;
  }

  .modal .btn-secondary {
    flex: 1 1 auto;
    padding: 12px 16px;
    font-size: 0.875rem;
    font-family: inherit;
    font-weight: 500;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: fit-content;
  }

  .modal .btn-secondary.icon svg {
    transition: transform 0.2s ease;
  }

  .modal .btn-secondary.icon.loading svg {
    animation: spin 0.7s linear infinite;
  }

  .modal .btn-primary {
    flex: 1 1 auto;
    padding: 12px 16px;
    font-size: 0.875rem;
    font-family: inherit;
    font-weight: 500;
    border: 1px solid var(--ink);
    border-radius: 8px;
    background: var(--ink);
    color: var(--canvas);
    cursor: pointer;
    transition: background 0.15s ease;
    min-width: fit-content;
  }

  .modal .btn-secondary:active,
  .modal .btn-primary:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .modal .btn-secondary:hover {
      background: var(--fill-hover);
    }

    .modal .btn-primary:hover {
      background: var(--ink-secondary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, ::before, ::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    /* Keep load state readable without motion: static ring + text. */
    .spinner {
      opacity: 1 !important;
    }

    button.loading .spinner,
    .modal .btn-secondary.icon.loading svg {
      animation: none !important;
    }
  }
</style>
</head>
<body>
  <main class="container">
    <header class="header">
      <h1>Watch movies and TV shows online</h1>
      <p class="subtitle">Paste an IMDb or TMDB ID or link to start.</p>
    </header>

    <form class="form-group" id="form">
      <label class="visually-hidden" for="imdb">IMDb or TMDB ID or link</label>
      <input type="text" id="imdb" name="id" placeholder="IMDb or TMDB ID or link" autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" enterkeyhint="go" aria-invalid="false">
      <button type="submit" id="go">
        <span class="spinner"></span>
        <span class="btn-text">Watch now</span>
      </button>
    </form>

    <p class="status" id="status" role="status" aria-live="polite"></p>
    <p class="help">Enter an IMDb or TMDB ID, e.g. <a href="#id=tt1300854">tt1300854</a>, or paste an IMDb or TMDB link. For TMDB, use the full link when asked.</p>
    <p class="help" id="recent"></p>
    <p class="disclaimer">We don't host anything. We only link to third-party providers. Check the URL before playing. Prefer an ad blocker for safety.</p>
  </main>

  <dialog class="modal" id="modal" aria-labelledby="modal-title">
      <h2 id="modal-title">Stream Found</h2>
      <p class="meta" id="modal-meta"></p>
      <p class="modal-description" id="modal-description" style="display: none;"></p>
      <div class="detail">
        <span class="detail-label">Type</span>
        <span class="detail-value" id="modal-type"></span>
      </div>
      <div class="detail">
        <span class="detail-label">Provider</span>
        <span class="detail-value" id="modal-provider"></span>
      </div>
      <div class="detail">
        <span class="detail-label">IMDB</span>
        <span class="detail-value"><a id="modal-imdb" href="#" target="_blank" rel="noopener"></a></span>
      </div>
      <div class="detail">
        <span class="detail-label">Stream URL</span>
        <span class="detail-value"><a id="modal-url-text" href="#" target="_blank" rel="noopener"></a></span>
      </div>
      <div class="warning">
        <span>You'll leave this site and play on </span>
        <strong id="modal-warning-provider"></strong>
        <span>. We don't control external sites.</span>
      </div>
      <div class="actions">
        <button class="btn-secondary" id="modal-cancel">Cancel</button>
        <button class="btn-secondary icon" id="modal-try-another" title="Get another stream link" aria-label="Get another stream link">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 1 1-3-6.7L21 8"/>
            <path d="M21 3v5h-5"/>
          </svg>
        </button>
        <button class="btn-secondary icon" id="modal-copy" title="Copy link" aria-label="Copy link">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
        <button class="btn-primary" id="modal-watch">Watch</button>
      </div>
  </dialog>

<script src="../scripts/watch.ts"></script>
</body>
</html>
